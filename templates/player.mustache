{{!
    @template mod_videoreview/player
}}
<div class="videoreview-player-wrap" data-region="player-wrap">
    {{#player.ishtml5}}
        <video class="videoreview-player" data-region="html5-player" controls preload="metadata" playsinline>
            <source src="{{{player.url}}}">
            {{#str}} videonotsupported, videoreview {{/str}}
        </video>
    {{/player.ishtml5}}
    {{#player.isyoutube}}
        <div class="videoreview-player videoreview-youtube" data-region="youtube-player"
             data-video-id="{{player.videoid}}"></div>
    {{/player.isyoutube}}
    {{#player.isvimeo}}
        <iframe class="videoreview-player videoreview-vimeo" data-region="vimeo-player"
                src="{{{player.embedurl}}}" allow="autoplay; fullscreen; picture-in-picture"
                allowfullscreen title="{{#str}} videoplayer, videoreview {{/str}}"></iframe>
    {{/player.isvimeo}}
    {{#player.ismissing}}
        <div class="alert alert-warning">{{#str}} videomissing, videoreview {{/str}}</div>
    {{/player.ismissing}}
</div>
