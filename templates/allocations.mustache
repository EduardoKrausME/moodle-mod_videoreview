{{!
    @template mod_videoreview/allocations
}}
<div class="videoreview-allocations">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h2 class="h3 mb-1">{{#str}} allocations, videoreview {{/str}}</h2>
            <p class="text-muted mb-0">{{#str}} allocationshelp, videoreview {{/str}} {{reviewcount}}</p>
        </div>
        <a class="btn btn-primary" href="{{{rebuildurl}}}">{{#str}} rebuildallocations, videoreview {{/str}}</a>
    </div>
    {{^hasrows}}
        <div class="alert alert-info">{{#str}} noallocations, videoreview {{/str}}</div>{{/hasrows}}
    {{#hasrows}}
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                <tr>
                    <th>{{#str}} reviewer, videoreview {{/str}}</th>
                    <th>{{#str}} author, videoreview {{/str}}</th>
                    <th>{{#str}} video, videoreview {{/str}}</th>
                    <th>{{#str}} status {{/str}}</th>
                </tr>
                </thead>
                <tbody>
                {{#rows}}
                    <tr>
                        <td>{{reviewer}}</td>
                        <td>{{author}}</td>
                        <td>{{title}}</td>
                        <td>{{status}}</td>
                    </tr>{{/rows}}
                </tbody>
            </table>
        </div>
    {{/hasrows}}
</div>
