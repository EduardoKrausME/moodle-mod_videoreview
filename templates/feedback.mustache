{{!
    @template mod_videoreview/feedback
}}
<div class="videoreview-review" data-region="videoreview-review" data-config="{{configjson}}">
    <div class="mb-3">
        <h2 class="h3">{{#str}} receivedreview, videoreview {{/str}}</h2>
        <div class="text-muted">{{title}} · {{reviewer}}</div>
        <div class="videoreview-score-badge mt-2">{{#str}} score, videoreview {{/str}}: {{score}}%</div>
    </div>
    {{> mod_videoreview/player }}
    <div class="videoreview-comment-timeline mt-2 mb-4" data-region="comment-timeline" role="group"
         aria-label="{{#str}} commenttimeline, videoreview {{/str}}">
        <div class="videoreview-comment-timeline-track"></div>
        {{#comments}}
            <button type="button" class="videoreview-comment-marker" data-action="seek" data-time="{{timecode}}"
                    data-comment-marker-id="{{id}}" title="{{timeformatted}}" aria-label="{{timeformatted}}"></button>
        {{/comments}}
    </div>
    <section class="card mt-4">
        <div class="card-body">
            <h3 class="h5">{{#str}} timestampedcomments, videoreview {{/str}}</h3>
            {{^hascomments}}<p class="text-muted">{{#str}} nocommentsyet, videoreview {{/str}}</p>{{/hascomments}}
            <ul class="list-unstyled videoreview-comments" data-region="comments">
                {{#comments}}
                    <li class="videoreview-comment">
                        <button type="button" class="btn btn-link p-0 videoreview-timecode" data-action="seek"
                                data-time="{{timecode}}">{{timeformatted}}</button>
                        <span class="videoreview-comment-text">{{{comment}}}</span>
                    </li>
                {{/comments}}
            </ul>
        </div>
    </section>
    <section class="card mt-4">
        <div class="card-body">
            <h3 class="h5">{{#str}} assessmentcriteria, videoreview {{/str}}</h3>
            {{#scores}}
                <div class="border-bottom py-2"><strong>{{name}}</strong>: {{value}}{{#feedback}}
                    <div class="text-muted">{{{feedback}}}</div>{{/feedback}}</div>
            {{/scores}}
            {{#overallfeedback}}
                <h4 class="h6 mt-3">{{#str}} overallfeedback, videoreview {{/str}}</h4>
                <div>{{{overallfeedback}}}</div>
            {{/overallfeedback}}
        </div>
    </section>
</div>
