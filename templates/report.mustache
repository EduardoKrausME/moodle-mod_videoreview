{{!
    @template mod_videoreview/report
}}
<div class="videoreview-report">
    <h2 class="h3">{{#str}} report, videoreview {{/str}}</h2>
    <h3 class="h5 mt-4">{{#str}} participationoverview, videoreview {{/str}}</h3>
    {{^hasrows}}<p class="text-muted">{{#str}} nodata, videoreview {{/str}}</p>{{/hasrows}}
    {{#hasrows}}
        <div class="table-responsive">
            <table class="table table-striped table-sm videoreview-report-table">
                <thead>
                <tr>
                    <th>{{#str}} participant, videoreview {{/str}}</th>
                    <th>{{#str}} submission, videoreview {{/str}}</th>
                    <th>{{#str}} reviewsassigned, videoreview {{/str}}</th>
                    <th>{{#str}} reviewsperformed, videoreview {{/str}}</th>
                    <th>{{#str}} reviewsreceived, videoreview {{/str}}</th>
                    <th>{{#str}} averagescore, videoreview {{/str}}</th>
                    <th>{{#str}} finalgrade, videoreview {{/str}}</th>
                    <th>{{#str}} averagewatch, videoreview {{/str}}</th>
                </tr>
                </thead>
                <tbody>{{#rows}}
                    <tr>
                        <td>{{user}}</td>
                        <td>{{submission}}</td>
                        <td>{{assigned}}</td>
                        <td>{{performed}}</td>
                        <td>{{received}}</td>
                        <td>{{average}}</td>
                        <td>{{grade}}</td>
                        <td>{{watchpercent}}</td>
                    </tr>{{/rows}}</tbody>
            </table>
        </div>
    {{/hasrows}}

    <h3 class="h5 mt-4">{{#str}} reviewdetails, videoreview {{/str}}</h3>
    {{^hasdetails}}<p class="text-muted">{{#str}} noreviews, videoreview {{/str}}</p>{{/hasdetails}}
    {{#hasdetails}}
        <div class="table-responsive">
            <table class="table table-striped table-sm">
                <thead>
                <tr>
                    <th>{{#str}} video, videoreview {{/str}}</th>
                    <th>{{#str}} author, videoreview {{/str}}</th>
                    <th>{{#str}} reviewer, videoreview {{/str}}</th>
                    <th>{{#str}} score, videoreview {{/str}}</th>
                    <th>{{#str}} comments, videoreview {{/str}}</th>
                    <th>{{#str}} viewingprogress, videoreview {{/str}}</th>
                    <th>{{#str}} date {{/str}}</th>
                </tr>
                </thead>
                <tbody>{{#details}}
                    <tr>
                        <td>{{video}}</td>
                        <td>{{author}}</td>
                        <td>{{reviewer}}</td>
                        <td>{{score}}</td>
                        <td>{{comments}}</td>
                        <td>{{watchpercent}}</td>
                        <td>{{date}}</td>
                    </tr>{{/details}}</tbody>
            </table>
        </div>
    {{/hasdetails}}

    <h3 class="h5 mt-4">{{#str}} criterionstatistics, videoreview {{/str}}</h3>
    {{^hascriterionstats}}<p class="text-muted">{{#str}} nocriteria, videoreview {{/str}}</p>{{/hascriterionstats}}
    {{#hascriterionstats}}
        <div class="table-responsive">
            <table class="table table-sm">
                <thead>
                <tr>
                    <th>{{#str}} criterion, videoreview {{/str}}</th>
                    <th>{{#str}} criteriontype, videoreview {{/str}}</th>
                    <th>{{#str}} average, videoreview {{/str}}</th>
                    <th>{{#str}} maxscore, videoreview {{/str}}</th>
                </tr>
                </thead>
                <tbody>{{#criterionstats}}
                    <tr>
                        <td>{{name}}</td>
                        <td>{{type}}</td>
                        <td>{{average}}</td>
                        <td>{{maxscore}}</td>
                    </tr>{{/criterionstats}}</tbody>
            </table>
        </div>
    {{/hascriterionstats}}
</div>
