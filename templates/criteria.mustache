{{!
    @template mod_videoreview/criteria
}}
<div class="mb-4">
    <h2 class="h3">{{#str}} criteria, videoreview {{/str}}</h2>
    <p class="text-muted">{{#str}} criteriahelp, videoreview {{/str}}</p>
    {{^hascriteria}}
        <div class="alert alert-info">{{#str}} nocriteria, videoreview {{/str}}</div>{{/hascriteria}}
    <div class="list-group">
        {{#criteria}}
            <div class="list-group-item">
                <div class="d-flex justify-content-between gap-3">
                    <div>
                        <strong>{{name}}</strong>
                        <span class="badge badge-light">{{type}}</span>
                        {{#required}}
                            <span class="badge badge-info">{{#str}} required, videoreview {{/str}}</span>{{/required}}
                        <div class="small text-muted">{{#str}} maxscore, videoreview {{/str}}: {{maxscore}}</div>
                        {{#description}}
                            <div class="mt-1">{{{description}}}</div>{{/description}}
                    </div>
                    <div class="text-nowrap">
                        <a class="btn btn-sm btn-outline-secondary" href="{{{editurl}}}">{{#str}} edit {{/str}}</a>
                        <a class="btn btn-sm btn-outline-danger" href="{{{deleteurl}}}">{{#str}} delete {{/str}}</a>
                    </div>
                </div>
            </div>
        {{/criteria}}
    </div>
</div>
